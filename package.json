{
  "name": "ludiday-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ludiday/web",
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build --workspace=@ludiday/core",
    "build:ui": "npm run build --workspace=@ludiday/ui",
    "build:web": "npm run build --workspace=@ludiday/web"
  },
  "devDependencies": {
    "@insforge/cli": "^0.2.8",
    "typescript": "^5.7.2"
  }
}
